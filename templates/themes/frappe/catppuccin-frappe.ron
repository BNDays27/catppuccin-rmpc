#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    show_song_table_header: false,
    draw_borders: false,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],
    background_color: "#303446",
    text_color: "#c6d0f5",
    header_background_color: None,
    modal_background_color: None,
    modal_backdrop: false,
    preview_label_style: (fg: "yellow"),
    preview_metadata_group_style: (fg: "yellow", modifiers: "Bold"),
    tab_bar: (
        active_style: (fg: "#303446", bg: "#ca9ee6", modifiers: "Bold"),
        inactive_style: (fg: "#c6d0f5", bg: "#303446"),
    ),
    highlighted_item_style: (fg: "#ca9ee6", modifiers: "Bold"),
    current_item_style: (bg: "#51576d", modifiers: "Bold"),
    borders_style: (fg: "#949cbb"),
    highlight_border_style: (fg: "#c6d0f5"),
    symbols: (
        song: "󰝚",
        dir: "󰀥",
        playlist: "󰲸",
        marker: "M",
        ellipsis: "...",
        song_style: None,
        dir_style: None,
        playlist_style: None,
    ),
    level_styles: (
        info: (fg: "#ca9ee6", bg: "#303446"),
        warn: (fg: "#e5c890", bg: "#303446"),
        error: (fg: "#e78284", bg: "#303446"),
        debug: (fg: "#a6d189", bg: "#303446"),
        trace: (fg: "#babbf1", bg: "#303446"),
    ),
  progress_bar: (
        symbols: ["█", "█", "", "█", "█"],
        track_style: (fg: "#292c3c"),
        elapsed_style: (fg: "#ca9ee6"),
        thumb_style: (fg: "#ca9ee6", bg: "#292c3c"),
    ), 
    scrollbar: (
        symbols: ["│", "█", "", "󰅀"],
        track_style: (fg: "#ca9ee6"),
        ends_style: (fg: "#303446"),
        thumb_style: (fg: "#ca9ee6"),
    ),
    song_table_format: [
        (
            prop: (kind: Property(Artist), style: (fg: "#ef9f76", modifiers: "Bold"),
                default: (kind: Text("Unknown"), style: (fg: "#ef9f76", modifiers: "Bold"))
            ),
            width: "20%",
	    alignment: Right,
        ),
        (
            prop: (kind: Text("-"), style: (fg: "#c6d0f5"), default: (kind: Text("Unknown"))),
            width: "1",
            alignment: Center,
        ),
	(
            prop: (kind: Property(Title), style: (fg: "#e5c890", modifiers: "Bold"),
                default: (kind: Text("Unknown"), style: (fg: "#e5c890", modifiers: "Bold"))
            ),
            width: "80%",
	    alignment: Left
        ),
    ],

header: (
	rows: [
	(
		left: [],
		center: [],
		right: [
		  (kind: Text(" ( "), style: (fg: "#c6d0f5", modififiers: "Bold")),
		  (kind: Property(Status(RepeatV2(on_label: "", off_label: "",
                                         on_style: (fg: "#a6d189", modifiers: "Bold"),
                                         off_style: (fg: "#626880", modifiers: "Bold"))))),

		  (kind: Text(" | "), style: (fg: "#c6d0f5", modififiers: "Bold")),

		  (kind: Property(Status(RandomV2(on_label: "", off_label: "",
                                         on_style: (fg: "#f4b8e4", modifiers: "Bold"),
                                         off_style: (fg: "#626880", modifiers: "Bold"))))), 

		  (kind: Text(" ) "), style: (fg: "#c6d0f5", modififiers: "Bold")),
		],

		)
	],


    ),

    components: {},
    layout: Split(
        direction: Vertical,
        panes: [
            (
                pane: Pane(Tabs),
                size: "1",
            ),
            (
                pane: Pane(Header),
                size: "1",
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            (
                pane: Pane(ProgressBar),
                size: "1",
            ),
        ],
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" - ")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],


cava: (
    // symbols that will be used to draw the bar in the visualiser, in ascending order of
    // fill fraction
    bar_symbols: ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'],
    // similar to bar_symbols but these are used for the top-down rendering, meaning for orientation
    // "Horizontal" and "Top"
    inverted_bar_symbols: ['▔', '🮂', '🮃', '▀', '🮄', '🮅', '🮆', '█'],

    //bg_color: "", // background color, defaults to rmpc's bg color if not provided
    bar_width: 1, // width of a single bar in columns
    bar_spacing: 1, // free space between bars in columns

    // Possible values are "Top", "Bottom" and "Horizontal". Top makes the bars go from top to
    // bottom, "Bottom" is from bottom up, and "Horizontal" is split in the middle with bars going
    // both down and up from there.
    // Using non-default symbols with "Top" and "Horizontal" may produce undesired output.
    orientation: Horizontal,

    // Colors can be configured in three different ways: a single color, different colors
    // per row and a gradient. You can use the same colors as everywhere else. Only specify
    // one of these:

    // Every bar symbol will be red
    //bar_color: Single("#ca9ee6"),

    bar_color: Gradient({

            12: "#81c8be",
            25: "#99d1db",
            36: "#85c1dc",
            50: "#8caaee",
            60: "#ca9ee6",
            75: "#f4b8e4",
            84: "#ea999c",
            100: "#e78284",    
    }),
  ),
    lyrics: (
        timestamp: false
    )
)
